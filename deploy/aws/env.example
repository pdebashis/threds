# Copy this file to .env.aws on the EC2 host. Do not commit .env.aws.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
RAILS_MASTER_KEY=replace-with-the-value-from-threds-api/config/master.key
API_DOMAIN=api.example.com
CORS_ORIGINS=https://www.example.com
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret